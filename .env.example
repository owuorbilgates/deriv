# =============================================================================
# Deriv Algorithmic Trading Bot - Environment Configuration Template
# Copy this file to .env and configure your personal credentials.
# NEVER commit your actual .env file or credentials to source control!
# =============================================================================

# Deriv API Credentials
# Obtain your Personal Access Token (PAT) from:
# https://home.deriv.com/dashboard/profile/api-tokens
# Register a PAT Application ID on https://developers.deriv.com/dashboard/create/?mode=new&type=pat
DERIV_API_TOKEN=your_deriv_personal_access_token_here
DERIV_APP_ID=your_registered_pat_app_id
DERIV_ACCOUNT_ID=your_options_account_id

# Official WebSocket Gateway
DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public

# Multi-Market Scanner Settings (The 5-Minute Rule)
DERIV_SCANNER_SYMBOLS=R_10,R_25,R_50,R_75,R_100
DERIV_SCANNER_INTERVAL=60

# Strategy: Momentum-Driven Mean Reversion (DIGITDIFF)
DERIV_CONTRACT_TYPE=DIGITDIFF
DERIV_DURATION=1
DERIV_STAKE_AMOUNT=0.35
DERIV_CURRENCY=USD
DERIV_DIGIT_WINDOW_SIZE=100
DERIV_DIGIT_THRESHOLD=14.0

# Risk Management & Martingale Recovery Protocol
DERIV_MARTINGALE_MULTIPLIER=11.0
DERIV_MARTINGALE_MAX_STEPS=2
DERIV_DAILY_STOP_LOSS=25.00
DERIV_DAILY_TAKE_PROFIT=5.00
DERIV_COOLDOWN_SECONDS=3.0
DERIV_MAX_CONSECUTIVE_LOSSES=4

# Simulation Mode (false = live trading, true = synthetic paper-trading)
DERIV_SIMULATION_MODE=false

# Logging Configuration
DERIV_LOG_FILE=deriv_trading_bot.log
DERIV_LOG_LEVEL=INFO
