# =============================================================================
# Deriv Algorithmic Trading Bot - Environment Configuration
# =============================================================================

# Deriv API Credentials
# Obtain your API token from: Deriv Account Settings -> API Token -> Select 'Read' and 'Trade' scopes
DERIV_API_TOKEN=your_deriv_api_token_here
# App ID: 1089 is Deriv's standard public app_id. You can also register a custom one on api.deriv.com
DERIV_APP_ID=1089

# WebSocket Endpoint
DERIV_WS_URL=wss://ws.binaryws.com/websockets/v3?app_id={app_id}

# Target Market
# Synthetic Volatility Indices: R_10, R_25, R_50, R_75, R_100, 1HZ100V
DERIV_SYMBOL=R_100

# Contract Configuration
# Strategy contract type: DIGITMATCH or DIGITDIFF
DERIV_CONTRACT_TYPE=DIGITDIFF
DERIV_STAKE_AMOUNT=1.00
DERIV_CURRENCY=USD
DERIV_DURATION=5
DERIV_DEFAULT_BARRIER=5

# Risk Management Parameters (Session Limits)
DERIV_DAILY_STOP_LOSS=10.00
DERIV_DAILY_TAKE_PROFIT=20.00
DERIV_COOLDOWN_SECONDS=3.0
DERIV_MAX_CONSECUTIVE_LOSSES=5

# Engine & Strategy Buffer
DERIV_TICK_BUFFER_SIZE=50

# Simulation Mode (true/false)
# Set to 'true' to run offline paper-trading simulation with synthetic ticks
DERIV_SIMULATION_MODE=false

# Logging
DERIV_LOG_FILE=deriv_trading_bot.log
DERIV_LOG_LEVEL=INFO
